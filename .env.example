# Copy to .env.local (never commit real values).
# Server-only: these are read by the enquiry Server Action and never sent to the browser.

# HTTPS endpoint that accepts a JSON POST with:
# { name, email, phone, service, message, source, submittedAt }
# Leave empty and the form tells visitors to call or WhatsApp instead.
ENQUIRY_WEBHOOK_URL=

# Optional bearer token for the endpoint above.
ENQUIRY_WEBHOOK_TOKEN=
